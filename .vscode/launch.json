{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32G431",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "stlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/platform/pmsm_foc_platform.elf",
      "gdbPath": "C:\\Arm\\13.3 rel1\\bin\\arm-none-eabi-gdb.exe",
      "preLaunchTask": "2. Build Project",
      "runToMain": false,
      "device": "STM32G431",

      "interface": "swd",

      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      }
    }
    ,
    {
      "name": "Debug STM32F767",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "stlink",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/platform/pmsm_foc_platform.elf",
      "gdbPath": "C:\\Arm\\13.3 rel1\\bin\\arm-none-eabi-gdb.exe",
      "preLaunchTask": "2. Build Project",
      "runToMain": false,
      "device": "STM32F767",
      "svdFile": "${workspaceFolder}/STM32F767.svd",
      "interface": "swd",
      "liveWatch": {
        "enabled": true,
        "samplesPerSecond": 4
      }
    }
  ]
}
